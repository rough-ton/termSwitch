<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for termSwitch's Windows build.

  Paste this into the SignPath project (Artifact configurations > New) and make
  it the default. The GitHub artifact arrives as a ZIP that holds one file,
  termSwitch-windows-x64.exe. SignPath signs only that file, and only when its
  metadata says it is termSwitch, so nothing else can be signed under this
  project. The metadata comes from termswitch.spec (the Windows version info).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="termSwitch-windows-x64.exe" max-matches="1"
             product-name="termSwitch" original-filename="termSwitch.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
